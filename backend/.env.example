DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/pawsstore
DB_ECHO=false

# Optional email overrides for the development seed
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_CUSTOMER_EMAIL=customer@example.com
# Set both passwords in .env before running the seed
# SEED_ADMIN_PASSWORD=
# SEED_CUSTOMER_PASSWORD=

# Generate a unique secret of at least 32 characters for JWT signing
# JWT_SECRET=
JWT_ACCESS_TOKEN_MINUTES=30
